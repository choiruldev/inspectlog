# ==============================================================================
# InspectLog — Production Environment Configuration (.env)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Security: Secret token untuk endpoint cron background monitoring (/api/cron/check)
# Set dengan string acak aman (cth: openssl rand -hex 32)
CRON_SECRET=ganti_dengan_token_acak_cron_rahasia_32_karakter

# Security: Kunci admin untuk melihat laporan feedback (/api/feedback)
ADMIN_KEY=ganti_dengan_kunci_admin_rahasia

# Security: Salt enkripsi password pengguna (Opsional, buat acak jika ingin salt unik)
PASSWORD_SALT=ganti_dengan_salt_acak_keamanan_password

# Google OAuth 2.0 (Dapatkan di Google Cloud Console -> APIs & Services -> Credentials)
# Redirect URI: https://domain-kamu.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payment Gateway Midtrans (Opsional jika ingin terima langganan Pro asli)
# Kosongkan jika masih ingin menggunakan sandbox simulator
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Set "true" jika ingin mengizinkan simulator pembayaran tetap aktif di production
ENABLE_PAYMENT_SIMULATOR=true

# Google Gemini AI (Opsional: untuk fitur "Diagnosa AI" pada log error)
# Dapatkan di Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
